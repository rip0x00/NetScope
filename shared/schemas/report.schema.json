{"$id":"https://netscope.dev/schemas/report.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"A complete diagnostic session: the results of every check that ran, the environment they ran in, and one session-level verdict. Reports are the unit of export and sharing; sensitive identifiers are redacted by default before a report leaves the device.","properties":{"generatedAt":{"format":"date-time","type":"string"},"platform":{"additionalProperties":false,"properties":{"appSurface":{"description":"Which NetScope application produced the report.","enum":["desktop","cli","mobile",null],"type":["string","null"]},"os":{"enum":["windows","linux","macos","android","ios","ipados","chromeos","freebsd","other"],"type":"string"},"osVersion":{"type":["string","null"]}},"required":["os"],"type":"object"},"redacted":{"default":true,"description":"Whether private identifiers (local addresses, SSIDs, hostnames of the user's own machines) were redacted before export.","type":"boolean"},"results":{"items":{"$ref":"diagnostic-result.schema.json"},"minItems":1,"type":"array"},"schemaVersion":{"const":"1.0"},"summary":{"additionalProperties":false,"properties":{"confidence":{"enum":["high","medium","low"],"type":"string"},"explanation":{"type":"string"},"recommendations":{"description":"Suggested verification steps. Recommendations must follow from the measured evidence in this report; they are advice, not automated actions.","items":{"type":"string"},"type":"array"},"verdict":{"enum":["OK","DNS_POISONED","DNS_BLOCKED","TCP_BLOCKED","TLS_SNI_BLOCKED","HTTP_FILTERED","SERVER_DOWN","NETWORK_UNREACHABLE","SLOW_UNSTABLE","UNKNOWN"],"type":"string"}},"required":["verdict","confidence","explanation"],"type":"object"},"target":{"additionalProperties":false,"properties":{"host":{"minLength":1,"type":"string"},"port":{"maximum":65535,"minimum":1,"type":["integer","null"]},"url":{"type":["string","null"]}},"required":["host"],"type":"object"},"tool":{"additionalProperties":false,"properties":{"name":{"const":"NetScope"},"version":{"minLength":1,"type":"string"}},"required":["name","version"],"type":"object"}},"required":["schemaVersion","tool","generatedAt","platform","target","results","summary"],"title":"NetScope Report","type":"object"}